{
  "openapi": "3.1.0",
  "info": {
    "title": "Umraa API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Service status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "service": { "type": "string" },
                    "timestamp": { "type": "string" }
                  },
                  "required": ["status", "service", "timestamp"]
                }
              }
            }
          }
        }
      }
    }
  }
}