# Required for NextAuth (use a strong random value in production)
AUTH_SECRET=change-me-use-openssl-rand-base64-32

# Must match the URL and port you run locally
NEXTAUTH_URL=http://localhost:3001

# Required for local and hosted runs (avoids UntrustedHost errors)
AUTH_TRUST_HOST=true

# Base URL of the MedFlow FastAPI backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Dev bearer token sent as "Authorization: Bearer <token>"; leave blank to omit the header
NEXT_PUBLIC_API_TOKEN=
