# Frontend environment variables. Copy to `.env.local` for local dev; for the
# Cloud Run build, set these as build-time env vars (Next.js inlines
# NEXT_PUBLIC_* at build time, not at runtime).

# Where the backend lives. Trailing slash optional. Default if unset:
# http://localhost:8000 — which only works for local dev.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Bearer token for `require_dev_token`. MUST match the backend's DEV_TOKEN env
# var; otherwise every request returns 401 and the packet page surfaces an
# auth-mismatch diagnostic. The backend will refuse to boot if its DEV_TOKEN
# is unset, but the FRONTEND silently sends no Authorization header when this
# is empty — see #90.
NEXT_PUBLIC_API_TOKEN=
