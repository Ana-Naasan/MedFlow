# Backend
APP_ENV=development
APP_NAME=umraa
APP_HOST=0.0.0.0
APP_PORT=8000

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Reasoning (Gemini) + knowledge services
GOOGLE_GENAI_API_KEY=PLACEHOLDER
OPENFDA_API_KEY=PLACEHOLDER

# Dev auth
DEV_TOKEN=PLACEHOLDER

# App database
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_NAME=umraa_app
APP_DB_USER=umraa
APP_DB_PASSWORD=umraa

# Institution A / B (seeded Postgres sources)
# The HOST/PORT/NAME/USER/PASSWORD vars below configure the local Postgres CONTAINERS
# (docker-compose institution_a/_b). The backend CONNECTOR instead reads INSTITUTION_*_DSN
# and connects as the SELECT-only `umraa_reader` role the seeds create. For bare-host
# `uvicorn`, the defaults already point at localhost:5433/5434 (the host-port mappings),
# so you only need to set these to use a different DB. Under `docker compose up` the
# backend service overrides them with the compose-network DSN automatically.
#
# Institution A
INSTITUTION_A_HOST=localhost
INSTITUTION_A_PORT=5433
INSTITUTION_A_NAME=institution_a
INSTITUTION_A_USER=umraa
INSTITUTION_A_PASSWORD=umraa
# INSTITUTION_A_DSN=postgresql://umraa_reader:umraa_reader@localhost:5433/institution_a

# Institution B
INSTITUTION_B_HOST=localhost
INSTITUTION_B_PORT=5434
INSTITUTION_B_NAME=institution_b
INSTITUTION_B_USER=umraa
INSTITUTION_B_PASSWORD=umraa
# INSTITUTION_B_DSN=postgresql://umraa_reader:umraa_reader@localhost:5434/institution_b