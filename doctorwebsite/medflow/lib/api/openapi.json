  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HypothesisActionRequest": {
        "properties": {
          "patient_id": {
            "type": "string",
            "title": "Patient Id"
          }
        },
        "type": "object",
        "required": [
          "patient_id"
        ],
        "title": "HypothesisActionRequest"
      },
      "HypothesisConfirmResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "title": "HypothesisConfirmResponse"
      },
      "HypothesisDismissResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "dismissed_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Dismissed Ids"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "dismissed_ids"
        ],
        "title": "HypothesisDismissResponse"
      },
      "IntakeRequest": {
        "properties": {
          "connector": {
            "type": "string",
            "title": "Connector",
            "description": "Registered connector ID, e.g. 'mock-fhir'."
          },
          "source_patient_id": {
            "type": "string",
            "title": "Source Patient Id",
            "description": "Patient ID as known to the source connector."
          },
          "patient_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Patient Id",
            "description": "Override the stored patient ID; auto-generated UUID if omitted."
          }
        },
        "type": "object",
        "required": [
          "connector",
          "source_patient_id"
        ],
        "title": "IntakeRequest"
      },
      "IntakeResponse": {
        "properties": {
          "patient_id": {
            "type": "string",
            "title": "Patient Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "resource_count": {
            "type": "integer",
            "title": "Resource Count"
          },
          "hypothesis_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Hypothesis Ids"
          }
        },
        "type": "object",
        "required": [
          "patient_id",
          "status",
          "resource_count"
        ],
        "title": "IntakeResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
